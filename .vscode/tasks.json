{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "接续自检（打开项目自动运行）",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/continuity/install-global-instruction.ps1"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "回归（构建 + 测试 + 冒烟）",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/regression.ps1"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "单元测试",
      "type": "shell",
      "command": "zig",
      "args": [
        "build",
        "test"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "构建并运行示例",
      "type": "shell",
      "command": "zig",
      "args": [
        "build",
        "run"
      ],
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
