<?xml version="1.0" encoding="utf-8"?>
<!--
  本库的模型（与 C# 侧同构的记忆：Model.xml 是结构唯一来源）。

  - 结构变更**只改这份文件**，启动时由 `Pek.ZCode` 的 `Dal.syncSchema` 做增量同步：
    缺表建表、缺列 `ALTER TABLE ... ADD COLUMN`、缺索引建索引（**不删列、不改类型**）。
  - 对应 C#：`Areas/Admin/Models` 生成的实体与 `Data/DH.db` 里的同名表。
-->
<EntityModel xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <Namespace>Pek.ZDsMallUI</Namespace>
    <!-- 默认连接名统一用 `DH`（与 C# `ConnectionStrings` 的业务库同名）。
         连接名的唯一来源就是本文件的 `ConnName`：项目要改名/分库，改自己那份 Model.xml，
         不要在代码里另起名字（Platform/Admin/Main/Traffic 这种“一库一种弄法”已废弃）。 -->
    <ConnName>DH</ConnName>
  </Option>
  <Tables>
    <!-- 配置表：**与 C# 框架的 `Config` 表同构**（Category / Name / Value / Remark），
         `Name` 就是实体属性名（PascalCase，如 `SiteName`），两边读写同一批键。
         旧版叫 `Setting(Key,Value)`，启动时会自动把数据搬过来（见 `migrateLegacySettingTable`）。 -->
    <Table Name="Config" TableName="Config" Description="站点配置（键值，对齐 C# Config 表）">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Category" DataType="String" Length="50" Nullable="True" Description="分类（可空）" />
        <Column Name="Name" DataType="String" Length="100" Description="配置名（= 实体属性名，如 SiteName）" />
        <Column Name="Value" DataType="String" Length="4000" Nullable="True" Description="配置值" />
        <Column Name="Remark" DataType="String" Length="200" Nullable="True" Description="备注（可空）" />
      </Columns>
      <Indexes>
        <Index Columns="Name" Unique="True" />
      </Indexes>
    </Table>
    <!--
      用户扩展表：**与 C# `UserDetail` 同构**（BYD 实测 `DG_UserDetail` 的 71 列逐项对齐；
      C# 侧表名前缀（`DG_`/`DH_`）由部署配置决定，本项目用无前缀的 `UserDetail`）。
      `Id` = `User.ID`（一对一，非自增）；**后台界面语言就存在 `LanguageId`**，
      与 C# 后台「每个管理员各自一份界面语言」的口径一致（不再自造 `AdminUser.LanguageId`）。
    -->
    <Table Name="UserDetail" TableName="UserDetail" Description="用户扩展表（C# `UserDetail` 同构；`Id` = `User.ID` 一对一，后台界面语言在 `LanguageId`）">
      <Columns>
        <Column Name="Id" DataType="Int32" PrimaryKey="True" Nullable="True" Description="编号（= User.ID）" />
        <Column Name="LanguageId" DataType="Int32" Nullable="False" DefaultValue="0" Description="后台界面语言（= Language.Id，0 = 跟默认）" />
        <Column Name="IsSuper" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsSuper" />
        <Column Name="SId" DataType="Int64" Nullable="False" DefaultValue="0" Description="SId" />
        <Column Name="TenantId" DataType="Int32" Nullable="False" DefaultValue="0" Description="TenantId" />
        <Column Name="UType" DataType="Int16" Nullable="False" DefaultValue="0" Description="UType" />
        <Column Name="RoleExIds" DataType="String" Length="100" Nullable="True" Description="RoleExIds" />
        <Column Name="OtherPermissions" DataType="String" Length="200" Nullable="True" Description="OtherPermissions" />
        <Column Name="DepartmentIds" DataType="String" Length="200" Nullable="True" Description="DepartmentIds" />
        <Column Name="TrueName" DataType="String" Length="50" Nullable="True" Description="TrueName" />
        <Column Name="PayPwd" DataType="String" Length="50" Nullable="True" Description="PayPwd" />
        <Column Name="AuthState" DataType="Int16" Nullable="False" DefaultValue="0" Description="AuthState" />
        <Column Name="IdCard" DataType="String" Length="50" Nullable="True" Description="IdCard" />
        <Column Name="IdcardImage1" DataType="String" Length="100" Nullable="True" Description="IdcardImage1" />
        <Column Name="IdcardImage2" DataType="String" Length="100" Nullable="True" Description="IdcardImage2" />
        <Column Name="IdcardImage3" DataType="String" Length="100" Nullable="True" Description="IdcardImage3" />
        <Column Name="CompanyName" DataType="String" Length="100" Nullable="True" Description="CompanyName" />
        <Column Name="CompnayAuthState" DataType="Int16" Nullable="False" DefaultValue="0" Description="CompnayAuthState" />
        <Column Name="CorporateName" DataType="String" Length="50" Nullable="True" Description="CorporateName" />
        <Column Name="BusinessLicenseImage" DataType="String" Length="100" Nullable="True" Description="BusinessLicenseImage" />
        <Column Name="CorporateImage" DataType="String" Length="100" Nullable="True" Description="CorporateImage" />
        <Column Name="EmailBind" DataType="Boolean" Nullable="False" DefaultValue="0" Description="EmailBind" />
        <Column Name="MobileBind" DataType="Boolean" Nullable="False" DefaultValue="0" Description="MobileBind" />
        <Column Name="IsSubScribe" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsSubScribe" />
        <Column Name="IsSales" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsSales" />
        <Column Name="IsEngineer" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsEngineer" />
        <Column Name="ReferrerId" DataType="Int32" Nullable="False" DefaultValue="0" Description="ReferrerId" />
        <Column Name="KeFuId" DataType="Int32" Nullable="False" DefaultValue="0" Description="KeFuId" />
        <Column Name="ParentUId" DataType="Int32" Nullable="False" DefaultValue="0" Description="ParentUId" />
        <Column Name="Points" DataType="Int32" Nullable="False" DefaultValue="0" Description="Points" />
        <Column Name="ExpPoints" DataType="Int32" Nullable="False" DefaultValue="0" Description="ExpPoints" />
        <Column Name="QQ" DataType="String" Length="50" Nullable="True" Description="QQ" />
        <Column Name="WeiXin" DataType="String" Length="50" Nullable="True" Description="WeiXin" />
        <Column Name="WangWang" DataType="String" Length="50" Nullable="True" Description="WangWang" />
        <Column Name="ContactName" DataType="String" Length="50" Nullable="True" Description="ContactName" />
        <Column Name="Tel" DataType="String" Length="50" Nullable="True" Description="Tel" />
        <Column Name="Fax" DataType="String" Length="50" Nullable="True" Description="Fax" />
        <Column Name="CompanyInfo" DataType="String" Length="1024" Nullable="True" Description="CompanyInfo" />
        <Column Name="Address" DataType="String" Length="100" Nullable="True" Description="Address" />
        <Column Name="InformAllow" DataType="Boolean" Nullable="False" DefaultValue="0" Description="InformAllow" />
        <Column Name="IsBuy" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsBuy" />
        <Column Name="IsAllowTalk" DataType="Boolean" Nullable="False" DefaultValue="0" Description="IsAllowTalk" />
        <Column Name="AvailablePredeposit" DataType="Decimal" Nullable="False" DefaultValue="0" Description="AvailablePredeposit" />
        <Column Name="FreezePredeposit" DataType="Decimal" Nullable="False" DefaultValue="0" Description="FreezePredeposit" />
        <Column Name="AvailableRcBalance" DataType="Decimal" Nullable="False" DefaultValue="0" Description="AvailableRcBalance" />
        <Column Name="FreezeRcBalance" DataType="Decimal" Nullable="False" DefaultValue="0" Description="FreezeRcBalance" />
        <Column Name="CountryCode" DataType="String" Length="50" Nullable="True" Description="CountryCode" />
        <Column Name="CountryId" DataType="Int32" Nullable="False" DefaultValue="0" Description="CountryId" />
        <Column Name="AreaId" DataType="Int32" Nullable="False" DefaultValue="0" Description="AreaId" />
        <Column Name="CityId" DataType="Int32" Nullable="False" DefaultValue="0" Description="CityId" />
        <Column Name="ProvinceId" DataType="Int32" Nullable="False" DefaultValue="0" Description="ProvinceId" />
        <Column Name="AreaInfo" DataType="String" Length="50" Nullable="True" Description="AreaInfo" />
        <Column Name="Question1" DataType="String" Length="100" Nullable="True" Description="Question1" />
        <Column Name="Answer1" DataType="String" Length="100" Nullable="True" Description="Answer1" />
        <Column Name="Question2" DataType="String" Length="100" Nullable="True" Description="Question2" />
        <Column Name="Answer2" DataType="String" Length="100" Nullable="True" Description="Answer2" />
        <Column Name="Question3" DataType="String" Length="100" Nullable="True" Description="Question3" />
        <Column Name="Answer3" DataType="String" Length="100" Nullable="True" Description="Answer3" />
        <Column Name="OnlineTime" DataType="Int32" Nullable="False" DefaultValue="0" Description="OnlineTime" />
        <Column Name="LastUpdateTime" DataType="Int64" Nullable="False" DefaultValue="0" Description="LastUpdateTime" />
        <Column Name="CreateUser" DataType="String" Length="50" Nullable="True" Description="CreateUser" />
        <Column Name="CreateUserID" DataType="Int32" Nullable="False" DefaultValue="0" Description="CreateUserID" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="True" Description="CreateTime" />
        <Column Name="CreateIP" DataType="String" Length="50" Nullable="True" Description="CreateIP" />
        <Column Name="UpdateUser" DataType="String" Length="50" Nullable="True" Description="UpdateUser" />
        <Column Name="UpdateUserID" DataType="Int32" Nullable="False" DefaultValue="0" Description="UpdateUserID" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="True" Description="UpdateTime" />
        <Column Name="UpdateIP" DataType="String" Length="50" Nullable="True" Description="UpdateIP" />
      </Columns>
    </Table>
    <Table Name="Session" TableName="Session" Description="会话吊销表（登出后令牌立即失效，重启仍有效）">
      <Columns>
        <Column Name="Key" DataType="String" Length="200" PrimaryKey="True" Description="键（含令牌/用户维度前缀）" />
        <Column Name="Value" DataType="String" Length="400" Description="值（会话/版本信息）" />
        <Column Name="ExpireAt" DataType="Int64" Description="过期 Unix 秒（0 = 不过期）" />
      </Columns>
      <Indexes>
        <Index Columns="ExpireAt" />
      </Indexes>
    </Table>
    <!--
      说明（表结构归属，2026-11-22 定）：
      **库内置模型只放库自身运行必需的最小表**（`Config` / `Session`），供库自测与「项目没给模型」时兜底。
      业务表与**多语言表**（`Language` / `LocaleStringResource`）属于**当前项目**，请在项目自己的 `Model.xml` 里定义
      —— 对齐 C#：`Model.xml` 是项目级结构唯一来源，库只提供控制器/服务。

      **用户 / 角色 / 部门 / 菜单 / 字典 / 地区 / 租户 / 日志**这些 Membership 表**不在这里定义**：
      它们来自 `Pek.ZCode` 的 `membership/Member.xml`（**C# 同源**），启动时与本文件合并后一次建表。
      早先这里自造过 `AdminUser`，与 C# 的 `User` 表结构不一致 → **同一份数据换语言就用不了**，已删除。

      缺语言表时不会崩：语言仓储读表失败会打 warn 并回退到内置中英文案，`/{area}/culture`、`/{area}/languages` 提示「未启用多语言」。
    -->
  </Tables>
</EntityModel>
