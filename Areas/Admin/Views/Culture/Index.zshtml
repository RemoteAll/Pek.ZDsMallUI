@{
    Layout = "Shared/_Layout";
}
@* 多语言：**结构与类名完全对齐 B2B2CShop `Areas/Admin/Views/Culture/Index.cshtml`**
   （`.page > .fixed-bar > .item-title > .subject + ul.tab-base.ds-row`、
   `form#formSearch > .ds-search-form`、`table.ds-default-table`、`ul.pagination`）。
   字段也与 C# 一致：Name / DisplayName / EnglishName / LanguageCulture / UniqueSeoCode / IsDefault / Status。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("多语言")</h3>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/culture/index" class="current"><span>@T("管理")</span></a></li>
                <li><a href="@Model.areaRoute/culture/addculture"><span>@T("新增")</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.saved != "") {
    <div class="explanation"><div class="title"><h4>@T("保存成功")</h4></div></div>
    }
    @if (Model.error != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@Model.error</h4></div></div>
    }

    <form method="get" name="formSearch" id="formSearch">
        <div class="ds-search-form">
            <dl>
                <dt>@T("关键字")</dt>
                <dd><input type="text" value="@Model.keyword" name="name" class="txt"></dd>
                <dd>
                    <select name="status">
                        <option value="-1">@T("请选择")</option>
                        <option value="1" @if (Model.statusFilter == 1) {<text>selected</text>}>@T("启用")</option>
                        <option value="0" @if (Model.statusFilter == 0) {<text>selected</text>}>@T("停用")</option>
                    </select>
                </dd>
            </dl>
            <div class="btn_group">
                <input type="submit" class="btn" value="@T("搜索")">
            </div>
        </div>
    </form>

    <table class="ds-default-table">
        <thead>
            <tr>
                <th class="w24"></th>
                <th>@T("标题")</th>
                <th>@T("显示名称")</th>
                <th>@T("英文名称")</th>
                <th>@T("语言缩写")</th>
                <th>@T("语言代码")</th>
                <th>@T("默认")</th>
                <th>@T("状态")</th>
                <th>@T("操作")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.rows) {
            <tr id="ds_row_@row.id">
                <td><input type="checkbox" class="checkitem" name="nav_id[]" value="@row.id"></td>
                <td>@row.name</td>
                <td>@row.displayName</td>
                <td>@row.englishName</td>
                <td>@row.languageCulture</td>
                <td>@row.code</td>
                <td>@if (row.isDefault) {<span class="dsui-status is-on">@T("是")</span>} else {<a class="dsui-status is-plain" href="@Model.areaRoute/culture/setdefault?id=@row.id" title='@T("设为默认语言")'>@T("设为默认")</a>}</td>
                @* 状态列直接在列表上切：点一下就走 `togglestatus`（GET + 重定向）。
                   默认语言不渲染链接 —— **不可停用**（前台翻译缺失时靠它兑底），链接样式也就不给，避免误点。 *@
                <td>
                    @if (row.isDefault) {
                    <span class="dsui-status is-on" title='@T("默认语言不可停用")'>@T("启用")</span>
                    } else if (row.enabled) {
                    <a class="dsui-status is-on" href="@Model.areaRoute/culture/togglestatus?id=@row.id&amp;enable=0" title='@T("点击停用")'>@T("启用")</a>
                    } else {
                    <a class="dsui-status is-off" href="@Model.areaRoute/culture/togglestatus?id=@row.id&amp;enable=1" title='@T("点击启用")'>@T("停用")</a>
                    }
                </td>
                <td>
                    <a href="@Model.areaRoute/culture/editculture?id=@row.id" class="dsui-btn-edit">@T("编辑")</a>
                    <a href="javascript:;" onclick="javascript:dsLayerConfirm('@Model.areaRoute/culture/delete?Ids=@row.id','@T("您确定要删除吗?")',@row.id)" class="dsui-btn-del">@T("删除")</a>
                </td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tfoot">
                <td><input type="checkbox" class="checkall" id="checkallBottom"></td>
                <td colspan="8">
                    <label for="checkallBottom">@T("全选")</label>
                    &nbsp;&nbsp;<a href="JavaScript:void(0);" class="btn btn-small" onclick="submit_delete_batch()"><span>@T("删除")</span></a>
                </td>
            </tr>
        </tfoot>
    </table>
    <ul class="pagination">@Raw(Model.pageHtml)</ul>
</div>
<script>
    // 与 C# `Culture/Index.cshtml` 一致：删除走 `Delete?Ids=`，由 `dsLayerConfirm` 发 AJAX（JSON 回执）。
    // 注意：**不要**改成原生 confirm —— 全项目禁止原生弹窗，且 JSON 回执不会刷新整页。
    function submit_delete(ids_str) {
        var _uri = "@Model.areaRoute/culture/delete?Ids=" + ids_str;
        dsLayerConfirm(_uri, '@T("您确定要删除吗?")');
    }
</script>
<style>
    /* 状态 / 默认列的可点徽标：只在本页用，不动框架全局样式。
       色彩成对（青绿=已启用、赭黄=已停用），悬停加深说明「能点」，
       `cursor:pointer` 只给链接（默认语言那枚是静态 span，不给人可点的错觉）。 */
    .dsui-status {
        display: inline-block;
        padding: 1px 10px;
        border-radius: 11px;
        font-size: 12px;
        line-height: 20px;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .dsui-status.is-on {
        color: #0f766e;
        background: #ccfbf1;
        border-color: #99f6e4;
    }

    .dsui-status.is-off {
        color: #9a3412;
        background: #ffedd5;
        border-color: #fed7aa;
    }

    .dsui-status.is-plain {
        color: #2563eb;
        background: #eff6ff;
        border-color: #bfdbfe;
        text-decoration: none;
    }

    a.dsui-status {
        cursor: pointer;
        text-decoration: none;
    }

    a.dsui-status.is-on:hover {
        background: #99f6e4;
    }

    a.dsui-status.is-off:hover {
        background: #fed7aa;
    }

    a.dsui-status.is-plain:hover {
        background: #dbeafe;
    }
</style>
