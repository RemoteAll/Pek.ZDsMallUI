@{
    Layout = "Shared/_Layout";
}
@* 多语言：**结构与类名完全对齐 B2B2CShop `Areas/Admin/Views/Culture/Index.cshtml`**
   （`.page > .fixed-bar > .item-title > .subject + ul.tab-base.ds-row`、
   `form#formSearch > .ds-search-form`、`table.ds-default-table`、`ul.pagination`）。
   字段也与 C# 一致：Name / DisplayName / EnglishName / LanguageCulture / UniqueSeoCode / IsDefault / Status。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@Model.lang.menu_culture</h3>
                <h5></h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/culture/index" class="current"><span>@Model.lang.common_manage</span></a></li>
                <li><a href="@Model.areaRoute/culture/addculture"><span>@Model.lang.common_add</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.saved != "") {
    <div class="explanation"><div class="title"><h4>@Model.lang.common_saved</h4></div></div>
    }
    @if (Model.error != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@Model.error</h4></div></div>
    }

    <form method="get" name="formSearch" id="formSearch">
        <div class="ds-search-form">
            <dl>
                <dt>@Model.lang.common_keyword</dt>
                <dd><input type="text" value="@Model.keyword" name="name" class="txt"></dd>
                <dd>
                    <select name="status">
                        <option value="-1">@Model.lang.common_please_select</option>
                        <option value="1" @if (Model.statusFilter == 1) {<text>selected</text>}>@Model.lang.common_enabled</option>
                        <option value="0" @if (Model.statusFilter == 0) {<text>selected</text>}>@Model.lang.common_disabled</option>
                    </select>
                </dd>
            </dl>
            <div class="btn_group">
                <input type="submit" class="btn" value="@Model.lang.common_search">
            </div>
        </div>
    </form>

    <table class="ds-default-table">
        <thead>
            <tr>
                <th class="w24"></th>
                <th>@Model.lang.common_title</th>
                <th>@Model.lang.common_display_name</th>
                <th>@Model.lang.page_culture_english</th>
                <th>@Model.lang.page_culture_language</th>
                <th>@Model.lang.page_culture_code</th>
                <th>@Model.lang.common_default</th>
                <th>@Model.lang.common_status</th>
                <th>@Model.lang.common_actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.rows) {
            <tr id="ds_row_@row.id">
                <td><input type="checkbox" class="checkitem" name="nav_id[]" value="@row.id"></td>
                <td>@row.name</td>
                <td>@row.displayName</td>
                <td>@row.englishName</td>
                <td>@row.languageCulture</td>
                <td>@row.code</td>
                <td>@if (row.isDefault) {<span>@Model.lang.common_yes</span>} else {<span>@Model.lang.common_no</span>}</td>
                <td>@if (row.enabled) {<span>@Model.lang.common_enabled</span>} else {<span>@Model.lang.common_disabled</span>}</td>
                <td>
                    <a href="@Model.areaRoute/culture/editculture?id=@row.id" class="dsui-btn-edit">@Model.lang.common_edit</a>
                    <a href="javascript:;" onclick="javascript:dsLayerConfirm('@Model.areaRoute/culture/delete?Ids=@row.id','@Model.lang.common_confirm_delete',@row.id)" class="dsui-btn-del">@Model.lang.common_delete</a>
                </td>
            </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tfoot">
                <td><input type="checkbox" class="checkall" id="checkallBottom"></td>
                <td colspan="8">
                    <label for="checkallBottom">@Model.lang.common_select_all</label>
                    &nbsp;&nbsp;<a href="JavaScript:void(0);" class="btn btn-small" onclick="submit_delete_batch()"><span>@Model.lang.common_delete</span></a>
                </td>
            </tr>
        </tfoot>
    </table>
    <ul class="pagination">@Raw(Model.pageHtml)</ul>
</div>
<script>
    // 与 C# `Culture/Index.cshtml` 一致：删除走 `Delete?Ids=`，由 `dsLayerConfirm` 发 AJAX（JSON 回执）。
    // 注意：**不要**改成原生 confirm —— 全项目禁止原生弹窗，且 JSON 回执不会刷新整页。
    function submit_delete(ids_str) {
        var _uri = "@Model.areaRoute/culture/delete?Ids=" + ids_str;
        dsLayerConfirm(_uri, '@Model.lang.common_confirm_delete');
    }
</script>
