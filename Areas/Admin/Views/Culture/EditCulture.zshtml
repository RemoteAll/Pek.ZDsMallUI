@{
    Layout = "Shared/_Layout";
}
@* 多语言-编辑：结构与 `AddCulture.cshtml` 完全一致（C# 也是同一套 `ds-default-table` 骨架）
   - 页签：管理（跳 index）/ 添加（current）
   - 表单：`form#doc_form > table.ds-default-table`
     每项两行：`tr > td.required > label.validation` + `tr.noborder > td.vatop.rowform > input.infoTableInput.w300`
     开关：`td.vatop.rowform.onoff > label.cb-enable/cb-disable + input[type=radio]`
   - 页脚：`tfoot > tr.tfoot > td[colspan] > input.btn[type=submit]`
   **不要自行改动版式**（用户要求与 C# 完全一致）。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("多语言")</h3>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/culture/index"><span>@T("管理")</span></a></li>
                <li><a href="javascript:void(0)" class="current"><span>@T("编辑")</span></a></li>
            </ul>
        </div>
    </div>

    <form id="doc_form" method="post" action="@Model.areaRoute/culture/saveculture">
        <input type="hidden" name="Id" value="@Model.row.id" />
        <table class="ds-default-table">
            <tbody>
                <tr>
                    <td class="required"><label class="validation">@T("标题")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="Name" id="Name" class="infoTableInput w300" value="@Model.row.name"></td>
                </tr>
                <tr>
                    <td class="required"><label class="validation">@T("显示名称")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="DisplayName" id="DisplayName" class="infoTableInput w300" value="@Model.row.displayName"></td>
                </tr>
                <tr>
                    <td class="required"><label class="validation">@T("英文名称")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="EnglishName" id="EnglishName" class="infoTableInput w300" value="@Model.row.englishName"></td>
                </tr>
                <tr>
                    <td class="required"><label class="validation">@T("语言缩写")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="LanguageCulture" id="LanguageCulture" class="infoTableInput w300" value="@Model.row.languageCulture"></td>
                </tr>
                <tr>
                    <td class="required"><label class="validation">@T("语言代码")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="UniqueSeoCode" id="UniqueSeoCode" class="infoTableInput w300" value="@Model.row.code"></td>
                </tr>
                <tr>
                    <td><label>@T("旗帜")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="Flag" id="Flag" class="infoTableInput w300" value="@Model.row.flag"></td>
                </tr>
                <tr>
                    <td><label>@T("域名")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="Domain" id="Domain" class="infoTableInput w300" value="@Model.row.domain"></td>
                </tr>
                <tr>
                    <td><label>LCID</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" name="Lcid" id="Lcid" class="infoTableInput w300" value="@Model.row.lcid"></td>
                </tr>
                <tr>
                    <td><label>@T("状态"):</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform onoff">
                        <label for="isbuy_1" class="cb-enable selected"><span>@T("启用")</span></label>
                        <label for="isbuy_2" class="cb-disable"><span>@T("停用")</span></label>
                        <input id="isbuy_1" name="Status" value="1" type="radio" @if (Model.row.enabled) {<text>checked="checked"</text>}>
                        <input id="isbuy_2" name="Status" value="0" type="radio" @if (!Model.row.enabled) {<text>checked="checked"</text>}>
                    </td>
                </tr>
                <tr>
                    <td><label>@T("是否默认"):</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform onoff">
                        <label for="isdefault_1" class="cb-enable"><span>@T("是")</span></label>
                        <label for="isdefault_2" class="cb-disable selected"><span>@T("否")</span></label>
                        <input id="isdefault_1" name="IsDefault" value="1" type="radio" @if (Model.row.isDefault) {<text>checked="checked"</text>}>
                        <input id="isdefault_2" name="IsDefault" value="0" type="radio" @if (!Model.row.isDefault) {<text>checked="checked"</text>}>
                    </td>
                </tr>
                <tr>
                    <td><label>@T("排序")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" value="100" name="DisplayOrder" id="DisplayOrder" class="infoTableInput w300" value="@Model.row.order"></td>
                </tr>
                <tr>
                    <td><label>@T("描述")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><textarea name="Remark" id="Remark" style="min-width: 800px; min-height: 100px;">@Model.row.remark</textarea></td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="tfoot">
                    <td colspan="15"><input class="btn" type="submit" value="@T("提交")" /></td>
                </tr>
            </tfoot>
        </table>
    </form>
</div>
