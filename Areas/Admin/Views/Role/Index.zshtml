@{
    Layout = "Shared/_Layout";
}
@* 角色权限管理 —— 版式与库内 Culture/Index.zshtml 一致（.page > .fixed-bar、table.ds-default-table）。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("角色权限管理")</h3>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/role/index" class="current"><span>@T("管理")</span></a></li>
                <li><a href="@Model.areaRoute/role/edit"><span>@T("新增")</span></a></li>
            </ul>
        </div>
    </div>

    <div class="explanation">
        <div class="title"><h4>@T("操作提示")</h4><span class="up"></span></div>
        <ul>
            <li>@T("角色 = 权限集合；用户通过 User.RoleID 归属角色。")</li>
            <li>@T("系统内置角色（超级管理员 / 管理员 / 普通用户）不可删除，但可以改权限与数据范围。")</li>
        </ul>
    </div>
    @if (Model.saved != "") {
    <div class="explanation"><div class="title"><h4>保存成功</h4></div></div>
    }
    @if (Model.deleted != "") {
    <div class="explanation"><div class="title"><h4>已删除</h4></div></div>
    }
    @if (Model.system != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">系统内置角色不允许删除</h4></div></div>
    }
    @if (Model.inuse != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">该角色还有用户在用，请先把这些用户改到其它角色</h4></div></div>
    }
    @if (Model.denied != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">操作被拒绝（角色不存在或不可删除）</h4></div></div>
    }
    @if (Model.ready == false) {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">数据库未启用：无法管理角色（请检查 Data/ 目录与配置）</h4></div></div>
    }

    <table class="ds-default-table">
        <thead>
            <tr>
                <th class="w48">ID</th>
                <th>@T("标题")</th>
                <th class="w80">类型</th>
                <th class="w80">@T("状态")</th>
                <th class="w80">系统</th>
                <th class="w80">排序</th>
                <th class="w160">@T("操作")</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.count == 0) {
            <tr><td colspan="7" style="text-align:center;padding:24px;">还没有角色，点右上角「@T("新增")」创建。</td></tr>
            }
            @foreach (var row in Model.rows) {
            <tr>
                <td>@row.id</td>
                <td>@row.name</td>
                <td>@if (row.type == 1) { <text>系统</text> } else if (row.type == 3) { <text>租户</text> } else { <text>普通</text> }</td>
                <td>@if (row.enable) { <span style="color:#1a7f37;">启用</span> } else { <span style="color:#999;">停用</span> }</td>
                <td>@if (row.isSystem) { <span style="color:#c00;">系统</span> }</td>
                <td>@row.sort</td>
                <td>
                    <a href="@Model.areaRoute/role/edit?id=@row.id" class="dsui-btn-edit">@T("编辑")</a>
                    @if (row.isSystem == false) {
                    <a href="javascript:;" onclick="javascript:dsLayerConfirm('@Model.areaRoute/role/delete?id=@row.id','@T("您确定要删除吗?")',@row.id)" class="dsui-btn-del">@T("删除")</a>
                    } else {
                    @* 系统内置角色不可删：仍然渲染按钮（置灰 + 提示），
                       否则列表里「完全看不到删除」会让人以为缺功能。 *@
                    <a href="javascript:;" onclick="javascript:layer.msg('@T("系统内置角色不允许删除")')" style="color:#bbb;margin-left:8px;cursor:not-allowed;" title="@T("系统内置角色不允许删除")">@T("删除")</a>
                    }
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
