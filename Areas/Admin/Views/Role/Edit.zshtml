@{
    Layout = "Shared/_Layout";
}
@* 角色 - 新增/编辑（版式照抄 C# `Areas/Admin/Views/Role/EditRole.cshtml`）。 *@
@* 页面级样式：C# 用的是 `asp-location="true"`（进 head），zzig 原样输出即可（浏览器接受 body 内 style）。 *@
<style>
    /* 权限表格：C# `table#tables` 的边框 / 圆角 / 阴影（admin.css 里没有，必须页面内声明） */
    .perm-table {
        width: 96%;
        margin: 6px 0 0;
        border: 1px solid #e6e6e6;
        border-radius: 2px;
        box-shadow: 0 2px 5px 0 rgba(0, 0, 0, .1);
        border-collapse: separate;
        border-spacing: 0;
        background: #fff;
    }
    .perm-table th, .perm-table td {
        border: 1px solid #e6e6e6;
        line-height: 35px;
        padding: 0 10px;
        text-align: left;
    }
    .perm-table th {
        font-weight: bold;
        color: #666;
        text-align: center;
        background: #fafafa;
    }
    .perm-table td.perm-group {
        background: #f5f8fa;
        font-weight: 600;
        color: #333;
    }
    .perm-table code {
        background: #f6f8fa;
        padding: 1px 5px;
        border-radius: 3px;
        color: #0b5cad;
    }
    .perm-table input[type=checkbox] {
        width: 16px;
        height: 16px;
        vertical-align: sub;
    }
    .perm-tip {
        color: #888;
        margin-top: 8px;
        width: 96%;
    }
    /* 编辑表单：`ds-default-table` 原本是列表页样式，宽度按内容收缩（实测只有 370px），
       这里强制拉满；C# 的 layui 表单也是整行铺开。 */
    table.form-table {
        width: 98% !important;
        margin: 20px 1%;
    }
    table.form-table td {
        width: auto;
    }
    table.form-table input.infoTableInput {
        width: 420px !important;
        max-width: 100%;
    }
</style>
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("角色权限管理")</h3>
                <h5>系统内置角色不允许改名；权限串格式与 C# 一致（如 `1#3,2#7`）</h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/role/index"><span>@T("管理")</span></a></li>
                <li><a href="javascript:void(0)" class="current"><span>@Model.title</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.error != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@Model.error</h4></div></div>
    }
    @if (Model.ready == false) {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">数据库未启用：无法保存角色</h4></div></div>
    }

    <form id="doc_form" method="post" action="@Model.areaRoute/role/save">
        <input type="hidden" name="id" value="@Model.id" />
        <table class="ds-default-table form-table">
            <tbody>
                <tr>
                    <td class="required"><label class="validation">角色名称</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        @if (Model.row.isSystem) {
                        <input type="text" value="@Model.row.name" name="name" id="name" class="infoTableInput w300" readonly>
                        <span style="color:#888;">系统内置角色不可改名。</span>
                        } else {
                        <input type="text" value="@Model.row.name" name="name" id="name" class="infoTableInput w300" required>
                        }
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">@T("状态")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform onoff">
                        <label for="enable_1" class="cb-enable @if (Model.row.enable) {<text>selected</text>}"><span>@T("启用")</span></label>
                        <label for="enable_0" class="cb-disable @if (Model.row.enable == false) {<text>selected</text>}"><span>@T("停用")</span></label>
                        <input id="enable_1" name="enable" value="1" type="radio" @if (Model.row.enable) {<text>checked</text>}>
                        <input id="enable_0" name="enable" value="0" type="radio" @if (Model.row.enable == false) {<text>checked</text>}>
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">排序（小的在前）</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="number" value="@Model.row.sort" name="sort" id="sort" class="infoTableInput w100"></td>
                </tr>
                <tr>
                    <td><label class="validation">@T("权限（勾选这个角色能进的页面）")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        @if (Model.row.permission == "*") {
                        <div style="padding:8px 0;color:#1a7f37;">@T("该角色拥有全部权限（超级管理员，权限串为 *）")</div>
                        <input type="hidden" name="permission[]" value="*" />
                        }
                        @if (Model.row.permission != "*") {
                        @* 版式照抄 C# `Role/EditRole.cshtml` 的 `table#tables`：名称 / 显示名 / 授权三列。
                           原来用 inline-block + min-width 排复选框，项目一多就挤成一行、行首不齐。 *@
                        <table class="perm-table">
                            <thead>
                                <tr>
                                    <th style="width:16%;">@T("名称")</th>
                                    <th style="width:32%;">@T("显示名")</th>
                                    <th style="width:11%;">@T("查看")</th>
                                    <th style="width:11%;">@T("编辑")</th>
                                    <th style="width:11%;">@T("保存")</th>
                                    <th>@T("删除")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in Model.permissionGroups) {
                                <tr>
                                    <td class="perm-group" colspan="6">@group.name</td>
                                </tr>
                                @foreach (var item in group.items) {
                                <tr>
                                    <td><code>@item.key</code></td>
                                    <td>@item.title</td>
                                    @foreach (var act in item.actions) {
                                    <td class="perm-act">
                                        @if (act.allowed) {
                                        <input type="checkbox" name="permission[]" value="@(item.key).@(act.name)" @if (act.check) {<text>checked</text>} title="@act.title">
                                        } else {
                                        <span style="color:#ccc;">-</span>
                                        }
                                    </td>
                                    }
                                </tr>
                                }
                                }
                            </tbody>
                        </table>
                        <div class="perm-tip">@T("勾选后，该角色的用户才能进入对应页面；未勾选一律 403。管理员账号不受此限制。")</div>
                        }
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="tfoot">
                    <td>
                        <input type="submit" class="btn" value="@T("保存")">
                        <a class="btn" href="@Model.areaRoute/role/index">@T("返回")</a>
                    </td>
                </tr>
            </tfoot>
        </table>
    </form>
</div>
