@{
    Layout = "Shared/_Layout";
}
@* 管理员管理 —— 版式与 `Role/Index.zshtml` 一致；只列后台账号（`User.Ex1 = 1`）。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("管理员管理")</h3>
                <h5>@T("后台账号 = User.Ex1=1；权限由所属角色决定（在角色权限管理里勾选）")</h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/adminuser/index" class="current"><span>@T("管理")</span></a></li>
                <li><a href="@Model.areaRoute/adminuser/edit"><span>@T("新增")</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.saved != "") {
    <div class="explanation"><div class="title"><h4>@T("保存成功")</h4></div></div>
    }
    @if (Model.deleted != "") {
    <div class="explanation"><div class="title"><h4>@T("已删除")</h4></div></div>
    }
    @if (Model.self != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@T("不能删除当前登录的账号")</h4></div></div>
    }
    @if (Model.lastsuper != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@T("这是最后一个超级管理员，不能删除或停用")</h4></div></div>
    }
    @if (Model.denied != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@T("操作被拒绝（记录不存在）")</h4></div></div>
    }
    @if (Model.ready == false) {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@T("数据库未启用：无法管理管理员")</h4></div></div>
    }

    <table class="ds-default-table">
        <thead>
            <tr>
                <th class="w48">ID</th>
                <th>@T("用户名")</th>
                <th>@T("显示名称")</th>
                <th>@T("角色权限管理")</th>
                <th class="w80">@T("状态")</th>
                <th>@T("联系邮箱")</th>
                <th class="w80">@T("登录")</th>
                <th class="w160">@T("操作")</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.count == 0) {
            <tr><td colspan="8" style="text-align:center;padding:24px;">@T("还没有管理员，点右上角「新增」创建。")</td></tr>
            }
            @foreach (var row in Model.rows) {
            <tr>
                <td>@row.id</td>
                <td>@row.name</td>
                <td>@row.displayName</td>
                <td>@row.roleName</td>
                <td>@if (row.enable) { <span style="color:#1a7f37;">@T("启用")</span> } else { <span style="color:#999;">@T("停用")</span> }</td>
                <td>@row.mail</td>
                <td>@row.logins</td>
                <td>
                    <a href="@Model.areaRoute/adminuser/edit?id=@row.id" class="dsui-btn-edit">@T("编辑")</a>
                    <a href="javascript:;" onclick="javascript:dsLayerConfirm('@Model.areaRoute/adminuser/delete?id=@row.id','@T("您确定要删除吗?")',@row.id)" class="dsui-btn-del">@T("删除")</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
