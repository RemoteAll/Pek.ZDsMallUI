@{
    Layout = "Shared/_Layout";
}
@* 管理员 - 新增/编辑（版式照抄 Role/Edit.zshtml）。口令留空 = 不修改。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("管理员管理")</h3>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/adminuser/index"><span>@T("管理")</span></a></li>
                <li><a href="javascript:void(0)" class="current"><span>@Model.title</span></a></li>
            </ul>
        </div>
    </div>

    <div class="explanation">
        <div class="title"><h4>@T("操作提示")</h4><span class="up"></span></div>
        <ul>
            <li>@T("口令留空表示不修改（新增时必须填）。")</li>
            <li>@T("口令按 md5+sha1 加盐存储，与 C# 口径一致；前端只提交 MD5，明文不进反代日志。")</li>
        </ul>
    </div>
    @if (Model.error != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@Model.error</h4></div></div>
    }
    @if (Model.ready == false) {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@T("数据库未启用：无法保存管理员")</h4></div></div>
    }

    <form id="doc_form" method="post" action="@Model.areaRoute/adminuser/save">
        <input type="hidden" name="id" value="@Model.id" />
        <table class="ds-default-table">
            <tbody>
                <tr>
                    <td class="required"><label class="validation">@T("用户名")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        <input type="text" value="@Model.row.name" name="name" id="name" class="infoTableInput w300" required autocomplete="off">
                        <span style="color:#888;">@T("登录名，全局唯一")</span>
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">@T("显示名称")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        <input type="text" value="@Model.row.displayName" name="displayName" id="displayName" class="infoTableInput w300">
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">@T("密码")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        <input type="password" name="password" id="password" class="infoTableInput w300" autocomplete="new-password">
                        <span style="color:#888;">@T("留空表示不修改")</span>
                    </td>
                </tr>
                <tr>
                    <td class="required"><label class="validation">@T("角色权限管理")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        <select name="roleId" id="roleId" class="infoTableInput w300">
                            @foreach (var role in Model.roles) {
                            <option value="@role.id" @if (role.current) {<text>selected</text>}>@role.name</option>
                            }
                        </select>
                        <span style="color:#888;">@T("该账号能访问哪些页面由这个角色的勾选决定")</span>
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">@T("状态")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform onoff">
                        <label for="enable_1" class="cb-enable @if (Model.row.enable) {<text>selected</text>}"><span>@T("启用")</span></label>
                        <label for="enable_0" class="cb-disable @if (Model.row.enable == false) {<text>selected</text>}"><span>@T("停用")</span></label>
                        <input id="enable_1" name="enable" value="1" type="radio" @if (Model.row.enable) {<text>checked</text>}>
                        <input id="enable_0" name="enable" value="0" type="radio" @if (Model.row.enable == false) {<text>checked</text>}>
                    </td>
                </tr>
                <tr>
                    <td><label class="validation">@T("联系邮箱")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" value="@Model.row.mail" name="mail" id="mail" class="infoTableInput w300"></td>
                </tr>
                <tr>
                    <td><label class="validation">手机</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform"><input type="text" value="@Model.row.mobile" name="mobile" id="mobile" class="infoTableInput w300"></td>
                </tr>
                <tr>
                    <td><label class="validation">@T("描述")</label></td>
                </tr>
                <tr class="noborder">
                    <td class="vatop rowform">
                        <textarea name="remark" id="remark" class="infoTableInput" rows="3" style="width:100%;">@Model.row.remark</textarea>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="tfoot">
                    <td>
                        <input type="submit" class="btn" value="@T("保存")">
                        <a class="btn" href="@Model.areaRoute/adminuser/index">@T("返回")</a>
                    </td>
                </tr>
            </tfoot>
        </table>
    </form>
</div>
