@* pek-zdsmallui:generated v3 *@
@{
    Layout = null;
}
@* 后台**欢迎页**（iframe 内显示；对应 C# `Areas/Admin/Views/Main/Index.cshtml` 的位置）。
   沿用 C# 原版 `admin.css` 的 `.page / .fixed-bar / .ncap-form-default` 版式。 *@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>欢迎页 - @Model.displayName</title>
    <link rel="stylesheet" href="/static/admin/css/admin.css">
    <link rel="stylesheet" href="/static/plugins/js/layui/css/layui.css">
</head>
<body>
    <div class="page">
        <div class="fixed-bar">
            <div class="item-title">
                <div class="subject">
                    <h3>@Model.displayName</h3>
                    <h5>当前用户：@Model.userName</h5>
                </div>
            </div>
        </div>

        <div class="ncap-form-default">
            <dl>
                <dt>站点名称</dt>
                <dd>@Model.siteName</dd>
            </dl>
            <dl>
                <dt>当前区域</dt>
                <dd><code>@Model.areaName</code>（路由前缀 <code>@Model.areaRoute</code>，可随配置改名）</dd>
            </dl>
            <dl>
                <dt>上传目录</dt>
                <dd>@Model.uploadPrefix</dd>
            </dl>
            <dl>
                <dt>后台版本</dt>
                <dd>@Model.version</dd>
            </dl>
            @if (Model.hasMenus) {
            <dl>
                <dt>快捷入口</dt>
                <dd>
                    @foreach (var menu in Model.menus) {
                    <a href="@menu.url" class="btn" title="@menu.desc" style="margin:0 8px 8px 0;">@menu.name</a>
                    }
                </dd>
            </dl>
            }
        </div>
    </div>
</body>
</html>
