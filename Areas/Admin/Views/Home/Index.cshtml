@{
    Layout = null;
}
@* 后台**框架页**（对齐 C# `Areas/Admin/Views/Home/DashBoard.cshtml` 的经典布局）：
   顶部 `.admincp-header`（logo + 一级导航 + 用户菜单）+ 左侧 `.admincp-container-left` 菜单
   + 右侧 iframe（`name="main-frame"`）。
   版式全部来自随包下发的 C# 原版 `admin.css`（`.admincp-*` / `.navbar` / `.sub-meun` 等类名一致），
   不依赖 jQuery —— 分组切换与 iframe 导航用原生 JS 实现。 *@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>@Model.title</title>
    <link rel="stylesheet" href="~/static/admin/css/admin.css">
    <link rel="stylesheet" href="~/static/plugins/js/layui/css/layui.css">
    <link rel="stylesheet" href="~/static/plugins/iconfont/iconfont.css">
    <style>
        html, body { height: 100%; margin: 0; }
        /* 框架页自身**不滚动**：滚动只发生在右侧 iframe 里。
           不写这条的话，`.admincp-container`（admin.css 里 height:100%）叠加 55px 头
           会把文档撑高 55px → 右侧出现垂直滚动条。 */
        body.admincp { overflow: hidden; }
        /* 头部实高是 55px（admin.css `.admincp-header{height:55px}`）。
           这里只是背景层，高度由绝对定位的左右两栏撑，不要再给 100%。 */
        .admincp-container { height: auto; }
        .admincp-container-right iframe { width: 100%; height: 100%; display: block; border: 0; }
        /* 右上角菜单右对齐：原版 `.sub-meun{left:0!important}` 从 li 左边起算，
           `.fr` 只有「您好，xxx」一个 li 且贴着视口右边 → 菜单向右溢出 20px（出水平滚动条）。
           原版 C# 之所以没事，是因为 `.fr` 后面还有「清除缓存 / 访问首页」两个 li 撑着宽度。 */
        .admincp-header .navbar .fr li .sub-meun { left: auto !important; right: 0; }
        .admincp-header .navbar .fr li dl:after { left: auto; right: 12px; }
        /* 可展开项给个三角提示（纯视觉，不改变 C# 的版式），并支持**点击**展开：
           原版只有 hover，鼠标没碰到时看着像没有下拉。 */
        .admincp-header .navbar .fr > li.has-sub > span::after { content: "▾"; margin-left: 4px; font-size: 10px; opacity: .85; }
        .admincp-header .navbar .fr > li.has-sub.open .sub-meun { display: block; }
        /* Language 二级菜单：主下拉贴着视口右边，所以二级**向左**弹出（否则出屏） */
        .admincp-header .navbar .fr li dl dd.has-child { position: relative; }
        .admincp-header .navbar .fr li dl dd.has-child > a::after { content: "\25C2"; float: right; margin-right: 4px; opacity: .85; }
        /* 关键：admin.css 给 `dl` 设了 `overflow:hidden`（为了圆角裁切），
           而二级菜单绝对定位到了 `dl` 外面 → 会被**裁掉**（computed style 看着是 block，肉眼却看不见）。
           这里放开裁剪，并把圆角补到首尾 dd 上，视觉效果不变。 */
        .admincp-header .navbar .fr li dl:has(dd.has-child) { overflow: visible; border-radius: 0; }
        .admincp-header .navbar .fr li dl:has(dd.has-child) > dd:first-child { border-radius: 5px 5px 0 0; }
        .admincp-header .navbar .fr li dl:has(dd.has-child) > dd:last-child { border-radius: 0 0 5px 5px; }
        .admincp-header .navbar .fr li dl dd.has-child > .sub-meun2 {
            position: absolute; top: -10px; right: 100%; display: none;
        }
        .admincp-header .navbar .fr li dl dd.has-child:hover > .sub-meun2,
        .admincp-header .navbar .fr li dl dd.has-child.open > .sub-meun2 { display: block; }
        .admincp-header .navbar .fr li dl .sub-meun2 dl { min-width: 110px; overflow: hidden; border-radius: 5px; }
        /* 内联 SVG 图标：尺寸/间距对齐 iconfont（`dl dd i` 是 float:left + margin-right:5px） */
        .admincp-header .navbar .fr li dl dd svg.nav-svg { width: 14px; height: 14px; margin-right: 5px; vertical-align: -2px; }
    </style>
</head>
<body class="admincp">
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    <div class="admincp-header">
        <div class="logo">
            <img src="~/static/admin/images/backlogo.png" alt="@Model.displayName">
        </div>
        <div class="navbar">
            <ul class="fl">
                @foreach (var group in Model.groups) {
                <li id="nav_@group.key"><a href="javascript:void(0)" data-group="@group.key">@group.name</a></li>
                }
            </ul>
            <ul class="fr">
                @* 右上角：**一个下拉装全部菜单**（按用户给的参考图）：
                   访问首页 / 清除缓存 / **Language（二级菜单：语言列表）** / 修改密码 / 安全退出。
                   `Language` 不做一级 li，而是主下拉里的一行 + 向右（贴边时向左）弹出的二级菜单。 *@
                <li class="has-sub">
                    <span>@(Model.lang.user_greeting)，@Model.userName</span>
                    <div class="sub-meun">
                        <dl>
                            <dd><a href="~/" target="_blank"><i class="iconfont">&#xe68e;</i>@Model.lang.user_home</a></dd>
                            <dd><a href="@Model.areaRoute/home/clearcache"><i class="iconfont">&#xe640;</i>@Model.lang.user_clear_cache</a></dd>
                            @if (Model.hasLanguages) {
                            <dd class="has-child">
                                @* 地球图标：iconfont 是商品分类图标库、没有 globe，所以用同风格内联 SVG
                                   （白色线条、随文字颜色走，尺寸/间距与 iconfont 图标一致） *@
                                <a href="javascript:;"><svg class="nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.8 2.6 15.2 0 18"></path><path d="M12 3c-2.6 2.8-2.6 15.2 0 18"></path></svg>@Model.lang.user_language</a>
                                <div class="sub-meun2">
                                    <dl>
                                        @foreach (var lang in Model.languages) {
                                        <dd><a href="@lang.url">@lang.name</a></dd>
                                        }
                                    </dl>
                                </div>
                            </dd>
                            }
                            <dd><a href="@Model.areaRoute/home/modifypw" target="main-frame"><i class="iconfont">&#xe67b;</i>@Model.lang.user_change_password</a></dd>
                            <dd><a href="javascript:dsLayerConfirm('@Model.areaRoute/login/logout','@Model.lang.user_logout_confirm','logout')"><i class="iconfont">&#xe70c;</i>@Model.lang.user_logout</a></dd>
                        </dl>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <div class="admincp-container">
        <div class="admincp-container-left">
            <div id="mainMenu">
                @foreach (var group in Model.groups) {
                <ul class="menu-group" data-group="@group.key">
                    @foreach (var item in group.items) {
                    <li><a href="javascript:void(0)" data-url="@item.url" data-name="@item.name"><i class="iconfont">@Html.Raw(item.icon)</i>@item.title</a></li>
                    }
                </ul>
                }
            </div>
        </div>
        <div class="admincp-container-right">
            <div class="top-border"></div>
            <iframe src="@Model.dashboardUrl" id="main-frame" name="main-frame" frameborder="0" scrolling="yes"></iframe>
        </div>
    </div>

    <script>
        (function () {
            var frame = document.getElementById('main-frame');
            var groups = Array.prototype.slice.call(document.querySelectorAll('#mainMenu .menu-group'));
            var navLinks = Array.prototype.slice.call(document.querySelectorAll('.admincp-header .navbar .fl a'));
            var items = Array.prototype.slice.call(document.querySelectorAll('#mainMenu a[data-url]'));

            // 顶部一级导航高亮：**类必须加在 li 上**（admin.css 是 `.navbar li.actived`），
            // 加在 `<a>` 上不会有任何视觉效果。
            function showGroup(key) {
                groups.forEach(function (g) {
                    g.style.display = g.getAttribute('data-group') === key ? 'block' : 'none';
                });
                navLinks.forEach(function (a) {
                    var li = a.closest('li') || a;
                    if (a.getAttribute('data-group') === key) { li.classList.add('actived'); }
                    else { li.classList.remove('actived'); }
                });
            }

            // 左侧子菜单高亮：同样必须加在 li 上（admin.css 是 `.admincp-container-left li.selected a`）
            function markSelected(target) {
                items.forEach(function (a) {
                    var li = a.closest('li');
                    if (li) { li.classList.remove('selected'); }
                    a.classList.remove('selected');
                });
                var li = target.closest('li');
                if (li) { li.classList.add('selected'); }
                target.classList.add('selected');
            }

            // 按 hash 激活子菜单：支持两种写法（两种都要能用，方便手写链接）
            //   #/admin/culture/index   —— 完整子页地址
            //   #culture                —— 菜单标识（`data-name`）
            function activateByHash(raw) {
                var key = decodeURIComponent((raw || '').replace(/^#/, ''));
                if (!key) { return false; }
                var target = null;
                items.forEach(function (a) {
                    if (a.getAttribute('data-url') === key || a.getAttribute('data-name') === key) { target = a; }
                });
                if (!target) { return false; }
                frame.src = target.getAttribute('data-url');
                markSelected(target);
                var group = target.closest ? target.closest('.menu-group') : null;
                if (group && group.getAttribute('data-group')) { showGroup(group.getAttribute('data-group')); }
                return true;
            }

            navLinks.forEach(function (a) {
                a.addEventListener('click', function () { showGroup(a.getAttribute('data-group')); });
            });

            items.forEach(function (a) {
                a.addEventListener('click', function () {
                    var url = a.getAttribute('data-url');
                    frame.src = url;
                    markSelected(a);
                    // 地址栏同步（用 replaceState 避免每次点菜单都往历史里塞一条）
                    if (location.hash !== '#' + url) {
                        if (history.replaceState) { history.replaceState(null, '', '#' + url); }
                        else { location.hash = url; }
                    }
                });
            });

            // Language 二级菜单：hover 已经能展开，这里补「点击展开」（触屏/不好 hover 时也能用）
            Array.prototype.slice.call(document.querySelectorAll('.admincp-header .navbar .fr li dl dd.has-child > a')).forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    a.parentNode.classList.toggle('open');
                });
            });

            // 浏览器前进/后退、或手改 hash 时跟着切
            window.addEventListener('hashchange', function () { activateByHash(location.hash); });

            // 右上角下拉：原版只有 hover；这里额外支持**点击展开**（鼠标没碰到时也能看到）
            var subItems = Array.prototype.slice.call(document.querySelectorAll('.admincp-header .navbar .fr > li.has-sub'));            subItems.forEach(function (li) {
                li.addEventListener('click', function (e) {
                    var isMenuClick = e.target.closest && e.target.closest('.sub-meun');
                    if (isMenuClick) { return; }  // 点菜单项本身：正常跳转
                    var willOpen = !li.classList.contains('open');
                    subItems.forEach(function (x) { x.classList.remove('open'); });
                    if (willOpen) { li.classList.add('open'); }
                    e.stopPropagation();
                });
            });
            document.addEventListener('click', function () {
                subItems.forEach(function (x) { x.classList.remove('open'); });
            });

            // 初始状态：地址栏带 hash 就直接打开对应子页；否则展开第一组并高亮欢迎页
            if (!activateByHash(location.hash)) {
                if (groups.length > 0) { showGroup(groups[0].getAttribute('data-group')); }
                if (items.length > 0) { items[0].classList.add('selected'); }
            }
        })();
    </script>
</body>
</html>
