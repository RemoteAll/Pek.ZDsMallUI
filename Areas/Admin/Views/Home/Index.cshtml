@{
    Layout = null;
}
@* 后台**框架页**（对齐 C# `Areas/Admin/Views/Home/DashBoard.cshtml` 的经典布局）：
   顶部 `.admincp-header`（logo + 一级导航 + 用户菜单）+ 左侧 `.admincp-container-left` 菜单
   + 右侧 iframe（`name="main-frame"`）。
   版式全部来自随包下发的 C# 原版 `admin.css`（`.admincp-*` / `.navbar` / `.sub-meun` 等类名一致），
   不依赖 jQuery —— 分组切换与 iframe 导航用原生 JS 实现。 *@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>@Model.title</title>
    <link rel="stylesheet" href="~/static/admin/css/admin.css">
    <link rel="stylesheet" href="~/static/plugins/js/layui/css/layui.css">
    <link rel="stylesheet" href="~/static/plugins/iconfont/iconfont.css">
    <style>
        html, body { height: 100%; margin: 0; }
        /* 框架页自身**不滚动**：滚动只发生在右侧 iframe 里。
           不写这条的话，`.admincp-container`（admin.css 里 height:100%）叠加 55px 头
           会把文档撑高 55px → 右侧出现垂直滚动条。 */
        body.admincp { overflow: hidden; }
        /* 头部实高是 55px（admin.css `.admincp-header{height:55px}`）。
           这里只是背景层，高度由绝对定位的左右两栏撑，不要再给 100%。 */
        .admincp-container { height: auto; }
        .admincp-container-right iframe { width: 100%; height: 100%; display: block; border: 0; }
        /* 右上角菜单右对齐：原版 `.sub-meun{left:0!important}` 从 li 左边起算，
           `.fr` 只有「您好，xxx」一个 li 且贴着视口右边 → 菜单向右溢出 20px（出水平滚动条）。
           原版 C# 之所以没事，是因为 `.fr` 后面还有「清除缓存 / 访问首页」两个 li 撑着宽度。 */
        .admincp-header .navbar .fr li .sub-meun { left: auto !important; right: 0; }
        .admincp-header .navbar .fr li dl:after { left: auto; right: 12px; }
    </style>
</head>
<body class="admincp">
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    <div class="admincp-header">
        <div class="logo">
            <img src="~/static/admin/images/backlogo.png" alt="@Model.displayName">
        </div>
        <div class="navbar">
            <ul class="fl">
                @foreach (var group in Model.groups) {
                <li id="nav_@group.key"><a href="javascript:void(0)" data-group="@group.key">@group.name</a></li>
                }
            </ul>
            <ul class="fr">
                <li>
                    <span>您好，@Model.userName</span>
                    <div class="sub-meun">
                        <dl>
                            <dd><a href="~/" target="_blank"><i class="iconfont">&#xe68e;</i>访问首页</a></dd>
                            <dd><a href="@Model.areaRoute/home/clearcache"><i class="iconfont">&#xe640;</i>清除缓存</a></dd>
                            <dd><a href="@Model.areaRoute/home/modifypw"><i class="iconfont">&#xe67b;</i>修改密码</a></dd>
                            <dd><a href="@Model.areaRoute/login/logout"><i class="iconfont">&#xe70c;</i>安全退出</a></dd>
                        </dl>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <div class="admincp-container">
        <div class="admincp-container-left">
            <div id="mainMenu">
                @foreach (var group in Model.groups) {
                <ul class="menu-group" data-group="@group.key">
                    @foreach (var item in group.items) {
                    <li><a href="javascript:void(0)" data-url="@item.url"><i class="iconfont">@Html.Raw(item.icon)</i>@item.name</a></li>
                    }
                </ul>
                }
            </div>
        </div>
        <div class="admincp-container-right">
            <div class="top-border"></div>
            <iframe src="@Model.dashboardUrl" id="main-frame" name="main-frame" frameborder="0" scrolling="yes"></iframe>
        </div>
    </div>

    <script>
        (function () {
            var frame = document.getElementById('main-frame');
            var groups = Array.prototype.slice.call(document.querySelectorAll('#mainMenu .menu-group'));
            var navLinks = Array.prototype.slice.call(document.querySelectorAll('.admincp-header .navbar .fl a'));
            var items = Array.prototype.slice.call(document.querySelectorAll('#mainMenu a[data-url]'));

            function showGroup(key) {
                groups.forEach(function (g) {
                    g.style.display = g.getAttribute('data-group') === key ? 'block' : 'none';
                });
                navLinks.forEach(function (a) {
                    if (a.getAttribute('data-group') === key) { a.classList.add('actived'); }
                    else { a.classList.remove('actived'); }
                });
            }

            navLinks.forEach(function (a) {
                a.addEventListener('click', function () { showGroup(a.getAttribute('data-group')); });
            });

            items.forEach(function (a) {
                a.addEventListener('click', function () {
                    frame.src = a.getAttribute('data-url');
                    items.forEach(function (x) { x.classList.remove('selected'); });
                    a.classList.add('selected');
                });
            });

            // 默认展开第一组，并高亮欢迎页
            if (groups.length > 0) { showGroup(groups[0].getAttribute('data-group')); }
            if (items.length > 0) { items[0].classList.add('selected'); }
        })();
    </script>
</body>
</html>
