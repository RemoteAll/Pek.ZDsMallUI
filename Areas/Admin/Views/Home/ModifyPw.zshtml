@{
    Layout = "Shared/_Layout";
}
@* 修改密码 —— 版式与库内其它后台页一致：`.page > .fixed-bar` 页头 + `.ncap-form-default` 表单行，
   控件类名/宽度沿用 C# 的 `.input-txt`（280px）。

   ★ 不要把「当前用户」再放进 `.item-title .subject`：admin.css 给 `.subject` 固定了
   `height:26px; line-height:26px; padding:6px 0`，塞第二行会向下溢出约 15px，
   **压住表单第一行的上边框**（2026-11-24 用户截图里「当前用户：admin 被一个框框住」就是它）。
   现在改成表单里的一行普通数据行。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("修改密码")</h3>
            </div>
        </div>
    </div>

    @if (Model.hasError) {
    <div class="explanation">
        <div class="title"><h4 style="color:#c00;">@Model.error</h4></div>
    </div>
    }

    <form method="post" action="@Model.areaRoute/home/modifypwsubmit" class="ncap-form-default">
        <dl>
            <dt>@T("当前用户")</dt>
            <dd><span style="line-height:26px;">@Model.userName</span></dd>
        </dl>
        <dl>
            <dt>@T("原密码")</dt>
            <dd><input type="password" name="OldPassword" class="input-txt" required autocomplete="current-password"></dd>
        </dl>
        <dl>
            <dt>@T("新密码")</dt>
            <dd><input type="password" name="Password" class="input-txt" required minlength="6" maxlength="20" autocomplete="new-password"></dd>
        </dl>
        <dl>
            <dt>@T("确认新密码")</dt>
            <dd><input type="password" name="RePassword" class="input-txt" required minlength="6" maxlength="20" autocomplete="new-password"></dd>
        </dl>
        <dl>
            <dt></dt>
            <dd>
                <button type="submit" class="btn">@T("保存")</button>
                <a href="@Model.areaRoute/home/dashboard" class="btn btn-default" style="margin-left:8px;">@T("返回")</a>
            </dd>
        </dl>
    </form>
</div>
