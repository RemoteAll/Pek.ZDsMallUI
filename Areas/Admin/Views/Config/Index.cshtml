@{
    Layout = "Shared/_Layout";
}
@* 站点设置页：**版式复用参考工程 C# `Areas/Admin/Views/Config/Index.cshtml`**
   （`.page > .fixed-bar > .item-title > .subject + ul.tab-base`，
   `.ncap-form-default > dl > dt + dd`，表单项 `input.input-txt` / `span.err`），
   样式全部来自 `admin.css`，本库不自造皮肤。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>站点设置</h3>
                <h5></h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/config/index" class="current"><span>站点设置</span></a></li>
                <li><a href="@Model.areaRoute/home/index"><span>后台首页</span></a></li>
                <li><a href="@Model.areaRoute/login/index"><span>登录页</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.saved) {
    <div class="explanation">
        <div class="title"><h4>保存成功</h4></div>
    </div>
    }

    <form method="post" action="@Model.areaRoute/config/updatebase" name="form1" class="admin-form">
        <div class="layui-tab layui-tab-brief Lan" lay-filter="configTab">
            <ul class="layui-tab-title">
                <li class="layui-this">标准:</li>
                @if (Model.hasLanguages) {
                @foreach (var lang in Model.languages) {
                <li>@lang.name</li>
                }
                }
            </ul>
            <div class="layui-tab-content">
                <div class="layui-tab-item layui-show">
                    <div class="ncap-form-default">
                        <dl>
                            <dt>网站名称</dt>
                            <dd>
                                <input id="SiteName" name="SiteName" value="@Model.siteName" class="input-txt" type="text" required>
                                <span class="err" id="SiteNameTip" style="display:none;"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>系统名称</dt>
                            <dd>
                                <input id="DisplayName" name="DisplayName" value="@Model.displayName" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>网站Seo标题</dt>
                            <dd>
                                <input id="SeoTitle" name="SeoTitle" value="@Model.seoTitle" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>网站Seo关键字</dt>
                            <dd>
                                <input id="SeoKey" name="SeoKey" value="@Model.seoKey" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>网站Seo描述</dt>
                            <dd>
                                <textarea id="SeoDescribe" name="SeoDescribe" rows="3">@Model.seoDescribe</textarea>
                            </dd>
                        </dl>
                        <dl>
                            <dt>ICP备案号</dt>
                            <dd>
                                <input id="Registration" name="Registration" value="@Model.registration" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>版权</dt>
                            <dd>
                                <input id="Copyright" name="Copyright" value="@Model.copyright" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>URL 后缀</dt>
                            <dd>
                                <input id="UrlSuffix" name="UrlSuffix" value="@Model.urlSuffix" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                    </div>

                    <div class="ncap-form-default">
                        <dl>
                            <dt>客服电话</dt>
                            <dd>
                                <input id="CustomerTel" name="CustomerTel" value="@Model.customerTel" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>客服邮箱</dt>
                            <dd>
                                <input id="CustomerEmail" name="CustomerEmail" value="@Model.customerEmail" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>当前域名</dt>
                            <dd>
                                <input id="curDomainUrl" name="curDomainUrl" value="@Model.curDomainUrl" class="input-txt" type="text" placeholder="https://example.com">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>统计代码</dt>
                            <dd>
                                <textarea id="Statistical" name="Statistical" rows="3">@Model.statistical</textarea>
                            </dd>
                        </dl>
                        <dl>
                            <dt>页脚</dt>
                            <dd>
                                <textarea id="PageFoot" name="PageFoot" rows="3">@Model.pageFoot</textarea>
                            </dd>
                        </dl>
                        <dl>
                            <dt>头部自定义 HTML</dt>
                            <dd>
                                <textarea id="HeaderCustomHtml" name="HeaderCustomHtml" rows="3">@Model.headerCustomHtml</textarea>
                            </dd>
                        </dl>
                        <dl>
                            <dt>底部自定义 HTML</dt>
                            <dd>
                                <textarea id="FooterCustomHtml" name="FooterCustomHtml" rows="3">@Model.footerCustomHtml</textarea>
                            </dd>
                        </dl>
                        <dl>
                            <dt></dt>
                            <dd>
                                <input type="submit" class="btn" value="保存设置">
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script src="~/static/admin/js/admin-config.js"></script>
}
