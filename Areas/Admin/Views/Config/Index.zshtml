@{
    Layout = "Shared/_Layout";
}
@* 站点设置：**结构与类名完全对齐 C# `Pek.DsMallUI/Areas/Admin/Views/Config/Index.cshtml`**
   - 页头：`.page > .fixed-bar > .item-title > .subject + ul.tab-base.ds-row`
   - 表单：`.layui-tab.layui-tab-brief.Lan > .layui-tab-title + .layui-tab-content > .layui-tab-item.layui-show > .ncap-form-default`
   - 行：`dl > dt + dd > input.input-txt + span.err + p.notic`
   只把 C# 的 tag helper（@T / Url.Action / BeginForm）换成模型取值，样式全部来自随包下发的原版 admin.css + layui。 *@
@* ★ 页面级样式必须照搬 C#：`.layui-tab.layui-tab-brief.Lan` 的 `box-shadow: 0 0 5px #AAA`
   就是「站点设置表单四周那圈灰边」的唯一来源（admin.css 里没有），漏了页面就“没有边框”。 *@
<style>
    .layui-tab-title {
        width: 95%;
        margin: 0 auto;
    }

    .layui-tab.layui-tab-brief.Lan {
        box-shadow: 0 0 5px #AAA inset;
        box-shadow: 0 0 5px #AAA;
    }
</style>
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("站点设置")</h3>
                <h5></h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/config/index" class="current"><span>@T("站点设置")</span></a></li>
            </ul>
        </div>
    </div>

    @* 不要加 `enctype="multipart/form-data"`：本页字段全是文本，而请求解析只支持
       `application/x-www-form-urlencoded`，加了会让所有字段都读不到（表现为「网站名称不可为空」）。 *@
    <form method="post" action="@Model.areaRoute/config/updatebase" name="form1">
        <div class="layui-tab layui-tab-brief Lan">
            <ul class="layui-tab-title">
                <li class="layui-this">@T("标准"):</li>
            </ul>
            <div class="layui-tab-content">
                <div class="layui-tab-item layui-show">
                    <div class="ncap-form-default">
                        <dl>
                            <dt>@T("网站名称")</dt>
                            <dd>
                                <input id="SiteName" name="SiteName" value="@Model.siteName" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo标题")</dt>
                            <dd>
                                <input id="SeoTitle" name="SeoTitle" value="@Model.seoTitle" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo关键字")</dt>
                            <dd>
                                <input id="SeoKey" name="SeoKey" value="@Model.seoKey" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo描述")</dt>
                            <dd>
                                <input id="SeoDescribe" name="SeoDescribe" value="@Model.seoDescribe" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("ICP备案号")</dt>
                            <dd>
                                <input id="registration" name="registration" value="@Model.registration" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("版权")</dt>
                            <dd>
                                <input id="copyright" name="copyright" value="@Model.copyright" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="ncap-form-default">
            <dl>
                <dt>@T("系统名称")</dt>
                <dd>
                    <input id="DisplayName" name="DisplayName" value="@Model.displayName" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("系统名称，将显示在后台顶部欢迎信息等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("网站域名")</dt>
                <dd>
                    <input id="CurDomainUrl" name="CurDomainUrl" value="@Model.curDomainUrl" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("网站的域名，必须 http:// 或 https:// 开头")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("公司名称")</dt>
                <dd>
                    <input id="companyname" name="companyname" value="@Model.company" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("公司名称，将会显示在底部等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("客服联系电话")</dt>
                <dd>
                    <input id="CustomerTel" name="CustomerTel" value="@Model.customerTel" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("客服联系电话，将会显示在头部或者底部等位置")</p>
                </dd>
            </dl>
            @* 联系邮箱：C# 站点设置页在「客服联系电话」之后（`name="CustomerEmail"`） *@
            <dl>
                <dt>@T("联系邮箱")</dt>
                <dd>
                    <input id="CustomerEmail" name="CustomerEmail" value="@Model.customerEmail" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("联系邮箱，将会显示在头部或者底部等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("前台页头")</dt>
                <dd>
                    <textarea name="HeaderCustomHtml" id="HeaderCustomHtml">@Model.headerCustomHtml</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            <dl>
                <dt>@T("前台页脚")</dt>
                <dd>
                    <textarea name="FooterCustomHtml" id="FooterCustomHtml">@Model.footerCustomHtml</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            <dl>
                <dt>@T("流量统计配置")</dt>
                <dd>
                    <textarea name="Statistical" id="Statistical">@Model.statistical</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            @* 会话超时 / 刷新用户周期：C# `Config/Index.cshtml` 里紧跟「流量统计配置」的两项 *@
            <dl>
                <dt>@T("会话超时")</dt>
                <dd>
                    <input id="sessiontimeout" name="sessiontimeout" value="@Model.sessionTimeout" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("单点登录后会话超时时间，该时间内可借助Cookie登录，默认0s")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("刷新用户周期")</dt>
                <dd>
                    <input id="refreshuserperiod" name="refreshuserperiod" value="@Model.refreshUserPeriod" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("该周期内多次SSO登录只拉取一次用户信息，默认600秒")</p>
                </dd>
            </dl>
            <dl>
                <dt></dt>
                <dd><a href="javascript:void(0)" class="btn" onclick="document.forms[0].submit()">@T("保存")</a></dd>
            </dl>
        </div>
    </form>
</div>
