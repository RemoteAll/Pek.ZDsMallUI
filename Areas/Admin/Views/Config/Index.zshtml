@{
    Layout = "Shared/_Layout";
}
@* 站点设置：**结构与类名完全对齐 C# `Pek.DsMallUI/Areas/Admin/Views/Config/Index.cshtml`**
   - 页头：`.page > .fixed-bar > .item-title > .subject + ul.tab-base.ds-row`
   - 表单：`.layui-tab.layui-tab-brief.Lan > .layui-tab-title + .layui-tab-content > .layui-tab-item.layui-show > .ncap-form-default`
   - 行：`dl > dt + dd > input.input-txt + span.err + p.notic`
   只把 C# 的 tag helper（@T / Url.Action / BeginForm）换成模型取值，样式全部来自随包下发的原版 admin.css + layui。 *@
@* ★ 页面级样式必须照搬 C#：`.layui-tab.layui-tab-brief.Lan` 的 `box-shadow: 0 0 5px #AAA`
   就是「站点设置表单四周那圈灰边」的唯一来源（admin.css 里没有），漏了页面就“没有边框”。 *@
<style>
    .layui-tab-title {
        width: 95%;
        margin: 0 auto;
    }

    .layui-tab.layui-tab-brief.Lan {
        box-shadow: 0 0 5px #AAA inset;
        box-shadow: 0 0 5px #AAA;
    }
</style>
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("站点设置")</h3>
            </div>
            @* 页签：**配置项全部集中在设置页**，按性质分两个标签。
               安全 / WAF 单独一标签（而不是藏在站点设置表单下面）—— 它们是**安全类配置**，
               以后 WAF 模式、CSRF、CC 限流也往这里放，不会和站点文案混在一起。 *@
            <ul class="tab-base ds-row">
                <li><a href="javascript:void(0)" class="current" data-cfg-tab="base"><span>@T("站点设置")</span></a></li>
                @if (Model.hasWaf) {
                <li><a href="javascript:void(0)" data-cfg-tab="security"><span>@T("安全（WAF）")</span></a></li>
                }
            </ul>
        </div>
    </div>

    <div class="cfg-pane" data-cfg-pane="base">
    @* 不要加 `enctype="multipart/form-data"`：本页字段全是文本，而请求解析只支持
       `application/x-www-form-urlencoded`，加了会让所有字段都读不到（表现为「网站名称不可为空」）。 *@
    <form method="post" action="@Model.areaRoute/config/updatebase" name="form1">
        <div class="layui-tab layui-tab-brief Lan">
            <ul class="layui-tab-title">
                <li class="layui-this">@T("标准"):</li>
                @foreach (var tab in Model.languageTabs) {
                <li>@tab.name</li>
                }
            </ul>
            <div class="layui-tab-content">
                <div class="layui-tab-item layui-show">
                    <div class="ncap-form-default">
                        <dl>
                            <dt>@T("网站名称")</dt>
                            <dd>
                                <input id="SiteName" name="SiteName" value="@Model.siteName" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo标题")</dt>
                            <dd>
                                <input id="SeoTitle" name="SeoTitle" value="@Model.seoTitle" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo关键字")</dt>
                            <dd>
                                <input id="SeoKey" name="SeoKey" value="@Model.seoKey" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo描述")</dt>
                            <dd>
                                <input id="SeoDescribe" name="SeoDescribe" value="@Model.seoDescribe" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("ICP备案号")</dt>
                            <dd>
                                <input id="registration" name="registration" value="@Model.registration" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        <dl>
                            <dt>@T("版权")</dt>
                            <dd>
                                <input id="copyright" name="copyright" value="@Model.copyright" class="input-txt" type="text">
                                <span class="err"></span>
                            </dd>
                        </dl>
                        @* Logo：存的是**图片地址**（可手填 CDN 地址，也可用右侧按钮上传到本站）。
                           前台头部有 Logo 就显示图片，没有则回退成站点名首字母圆标。 *@
                        <dl>
                            <dt>@T("站点Logo")</dt>
                            <dd>
                                <input id="Logo" name="Logo" value="@Model.logo" class="input-txt" type="text" placeholder="@T("图片地址；或点右侧「上传」")">
                                <span class="err"></span>
                                <input id="logoFile" type="file" accept="image/*" style="display:none">
                                <a href="javascript:void(0)" class="dsui-btn-edit" id="logoUploadBtn">@T("上传图片")</a>
                                <p class="logo-tip">@T("建议正方形 PNG/SVG，高度 32~64 像素；留空则用站点名首字母。")</p>
                                <img id="logoPreview" class="logo-preview" alt="" src="@Model.logo">
                            </dd>
                        </dl>
                    </div>
                </div>
                @* 每种已启用语言一个 Tab：字段名 `{语言ID}.字段` → `SiteInfoLan` 表（对齐 C#） *@
                @foreach (var tab in Model.languageTabs) {
                <div class="layui-tab-item">
                    <div class="ncap-form-default">
                        <dl>
                            <dt>@T("网站名称")</dt>
                            <dd><input name="@(tab.id).SiteName" value="@tab.siteName" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo标题")</dt>
                            <dd><input name="@(tab.id).SeoTitle" value="@tab.seoTitle" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo关键字")</dt>
                            <dd><input name="@(tab.id).SeoKey" value="@tab.seoKey" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                        <dl>
                            <dt>@T("网站Seo描述")</dt>
                            <dd><input name="@(tab.id).SeoDescribe" value="@tab.seoDescribe" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                        <dl>
                            <dt>@T("ICP备案号")</dt>
                            <dd><input name="@(tab.id).Registration" value="@tab.registration" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                        <dl>
                            <dt>@T("版权")</dt>
                            <dd><input name="@(tab.id).SiteCopyright" value="@tab.copyright" class="input-txt" type="text"><span class="err"></span></dd>
                        </dl>
                    </div>
                </div>
                }
            </div>
        </div>

        <div class="ncap-form-default">
            <dl>
                <dt>@T("系统名称")</dt>
                <dd>
                    <input id="DisplayName" name="DisplayName" value="@Model.displayName" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("系统名称，将显示在后台顶部欢迎信息等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("网站域名")</dt>
                <dd>
                    <input id="CurDomainUrl" name="CurDomainUrl" value="@Model.curDomainUrl" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("网站的域名，必须 http:// 或 https:// 开头")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("公司名称")</dt>
                <dd>
                    <input id="companyname" name="companyname" value="@Model.company" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("公司名称，将会显示在底部等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("客服联系电话")</dt>
                <dd>
                    <input id="CustomerTel" name="CustomerTel" value="@Model.customerTel" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("客服联系电话，将会显示在头部或者底部等位置")</p>
                </dd>
            </dl>
            @* 联系邮箱：C# 站点设置页在「客服联系电话」之后（`name="CustomerEmail"`） *@
            <dl>
                <dt>@T("联系邮箱")</dt>
                <dd>
                    <input id="CustomerEmail" name="CustomerEmail" value="@Model.customerEmail" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("联系邮箱，将会显示在头部或者底部等位置")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("前台页头")</dt>
                <dd>
                    <textarea name="HeaderCustomHtml" id="HeaderCustomHtml">@Model.headerCustomHtml</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            <dl>
                <dt>@T("前台页脚")</dt>
                <dd>
                    <textarea name="FooterCustomHtml" id="FooterCustomHtml">@Model.footerCustomHtml</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            <dl>
                <dt>@T("流量统计配置")</dt>
                <dd>
                    <textarea name="Statistical" id="Statistical">@Model.statistical</textarea>
                    <span class="err"></span>
                </dd>
            </dl>
            @* 会话超时 / 刷新用户周期：C# `Config/Index.cshtml` 里紧跟「流量统计配置」的两项 *@
            <dl>
                <dt>@T("会话超时")</dt>
                <dd>
                    <input id="sessiontimeout" name="sessiontimeout" value="@Model.sessionTimeout" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("单点登录后会话超时时间，该时间内可借助Cookie登录，默认0s")</p>
                </dd>
            </dl>
            <dl>
                <dt>@T("刷新用户周期")</dt>
                <dd>
                    <input id="refreshuserperiod" name="refreshuserperiod" value="@Model.refreshUserPeriod" class="input-txt" type="text">
                    <span class="err"></span>
                    <p class="notic">@T("该周期内多次SSO登录只拉取一次用户信息，默认600秒")</p>
                </dd>
            </dl>
            <dl>
                <dt></dt>
                <dd><a href="javascript:void(0)" class="btn" onclick="document.forms[0].submit()">@T("保存")</a></dd>
            </dl>
        </div>
    </form>
    </div>

    @if (Model.hasWaf) {
    @* 安全标签：抓取开关等**安全类配置**放这里（体检页只负责提醒「去哪里调」，不放表单）。
       独立 form：它写的是 `Config/Waf.toml`（WAF 配置），与上面写数据库 Setting 的站点设置不是一回事，
       混在一个表单里会让「保存」同时触发两套落盘逻辑，排查困难。 *@
    <div class="cfg-pane" data-cfg-pane="security" hidden>
        <form method="post" action="@Model.areaRoute/config/savecrawl" name="formCrawl" id="formCrawl">
            <div class="layui-tab layui-tab-brief Lan">
                <div class="ncap-form-default">
                    <dl>
                    <dt>@T("搜索引擎与 AI")</dt>
                    <dd>
                        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                            <input type="checkbox" name="allowSearchBots" value="1" @if (Model.searchBotsAllowed) {<text>checked</text>}>
                            <span>@T("搜索引擎抓取（Google / Bing 等）")</span>
                        </label>
                        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-left:18px;">
                            <input type="checkbox" name="allowAiBots" value="1" @if (Model.aiBotsAllowed) {<text>checked</text>}>
                            <span>@T("AI 抓取（GPTBot / PerplexityBot 等，GEO）")</span>
                        </label>
                        <p class="notic">@T("关掉搜索引擎抓取 = 所有爬虫（含 Google / Bing）拿到 403，整站搜不到；")@T("AI 抓取按需开启：内容站通常想被生成式引擎引用，内部系统 / 付费内容通常不想。")</p>
                        <p class="notic">@T("保存在 Config/Waf.toml，改完立即生效，无需重启。")</p>
                    </dd>
                </dl>
                <dl>
                    <dt></dt>
                    <dd><a href="javascript:void(0)" class="btn" onclick="document.forms['formCrawl'].submit()">@T("保存抓取开关")</a></dd>
                </dl>
            </div>
        </div>
        </form>
    </div>
    }
</div>
@* 语言 Tab 切换（不引 layui 的 element 模块，10 行原生 JS 足够）：
   点标题 → 切 `.layui-this` 与 `.layui-tab-item.layui-show`。 *@
<script>
    // ————— 页签：站点设置 / 安全（WAF）—————
    // 纯前端显隐，不刷新 —— 切标签不丢已填内容；两个 pane 各自一个 form，互不干扰。
    (function () {
        var tabs = document.querySelectorAll('[data-cfg-tab]');
        if (!tabs.length) return;
        var panes = document.querySelectorAll('[data-cfg-pane]');
        Array.prototype.forEach.call(tabs, function (tab) {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                var key = tab.getAttribute('data-cfg-tab');
                Array.prototype.forEach.call(tabs, function (t) { t.classList.toggle('current', t === tab); });
                Array.prototype.forEach.call(panes, function (p) {
                    p.hidden = p.getAttribute('data-cfg-pane') !== key;
                });
            });
        });
    })();

    // ————— 语言 Tab 切换（不引 layui 的 element 模块，10 行原生 JS 足够）：
    // 点标题 → 切 `.layui-this` 与 `.layui-tab-item.layui-show`。
    // 只取**站点设置** pane 里那一份（安全 pane 里也有 `.layui-tab`，不能让它被选中）。
    (function () {
        var box = document.querySelector('[data-cfg-pane="base"] .layui-tab.layui-tab-brief.Lan');
        if (!box) return;
        var titles = box.querySelectorAll('.layui-tab-title > li');
        var panels = box.querySelectorAll('.layui-tab-content > .layui-tab-item');
        for (var i = 0; i < titles.length; i++) {
            (function (idx) {
                titles[idx].addEventListener('click', function () {
                    for (var j = 0; j < titles.length; j++) titles[j].classList.remove('layui-this');
                    for (var j = 0; j < panels.length; j++) panels[j].classList.remove('layui-show');
                    titles[idx].classList.add('layui-this');
                    if (panels[idx]) panels[idx].classList.add('layui-show');
                });
            })(i);
        }
    })();

    // ————— 站点 Logo 上传 —————
    // 复用 UEditor 的图片上传接口（`/fileuploader?action=uploadimage`，返回
    // `{"state":"SUCCESS","url":"/upload/....png"}`），成功只回填 URL + 预览，
    // **不自动保存** —— 与其它字段一致，仍由底部「保存」统一提交。
    (function () {
        var btn = document.getElementById('logoUploadBtn');
        var file = document.getElementById('logoFile');
        var input = document.getElementById('Logo');
        var preview = document.getElementById('logoPreview');
        if (!btn || !file || !input) { return; }

        function refresh() {
            var url = (input.value || '').trim();
            if (!preview) { return; }
            if (url) { preview.src = url; preview.style.display = ''; }
            else { preview.removeAttribute('src'); preview.style.display = 'none'; }
        }
        input.addEventListener('change', refresh);
        refresh();

        btn.addEventListener('click', function () { file.click(); });
        file.addEventListener('change', function () {
            var picked = file.files && file.files[0];
            if (!picked) { return; }
            var body = new FormData();
            body.append('upfile', picked);
            btn.textContent = '上传中…';
            fetch('/fileuploader?action=uploadimage', { method: 'POST', body: body, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data && (data.state === 'SUCCESS' || data.state === 'SUCCESS ') && data.url) {
                        input.value = data.url;
                        refresh();
                        btn.textContent = '已上传（记得保存）';
                    } else {
                        btn.textContent = '上传图片';
                        alert('上传失败：' + ((data && (data.state || data.message)) || '未知原因'));
                    }
                })
                .catch(function (err) {
                    btn.textContent = '上传图片';
                    alert('上传失败：' + err);
                });
        });
    })();
</script>
