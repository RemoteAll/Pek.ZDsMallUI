@* 登录页：**版式复用参考工程 C# `Areas/Admin/Views/Login/Index.cshtml`**
   （`admin.css` 里的 `.login / .login_body / .login_header / .login_content`，
   表单项 `.form-group` + `input.text`，按钮 `.btn`，背景图 `/static/admin/images/wallpage/bg_1.jpg`）。
   这些静态资源由本库随包下发（与 C# `Pek.NCubeUI.DsMallUI` 同一份原文）。
   不套 `_Layout`：登录页是独立页面。 *@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>@T("登录") - @Model.displayName</title>
    <link rel="stylesheet" href="~/static/admin/css/admin.css">
    <link rel="stylesheet" href="~/static/plugins/js/layui/css/layui.css">
    <style>
        body { background-image: url('/static/admin/images/wallpage/bg_1.jpg'); background-size: cover; background-position: center; }
        .login_content .err-tip { color: #d93026; margin-bottom: 12px; }
    </style>
</head>
<body>
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    <div class="login">
        <div class="login_body">
            <div class="login_header">
                <img src="~/static/admin/images/logo.png" alt="@Model.displayName">
            </div>
            <div class="login_content">
                @if (Model.hasError) {
                <div class="err-tip">@Model.error</div>
                }
                <form method="post" action="@Model.areaRoute/login/login" id="login_form" class="admin-form">
                    <input type="hidden" name="returnUrl" value="@Model.returnUrl">
                    <div class="form-group">
                        <input type="text" id="username" name="UserName" value="@Model.userName" placeholder="@T("用户名")" required class="text" autocomplete="username">
                    </div>
                    <div class="form-group">
                        <input type="password" id="password" name="Password" placeholder="@T("密码")" required class="text" autocomplete="current-password">
                    </div>
                    @if (Model.requireCaptcha) {
                    <div class="form-group" style="display:flex;gap:8px;align-items:center;">
                        <input type="text" name="Captcha" placeholder="@T("验证码")" required maxlength="8" autocomplete="off" class="text" style="flex:1;">
                        <img src="@Model.captchaUrl" alt="@T("验证码")" title="@T("看不清？点击刷新")" data-url="@Model.captchaUrl"
                             style="height:38px;border-radius:8px;cursor:pointer;"
                             onclick="this.src=this.getAttribute('data-url')+'?t='+Date.now();">
                    </div>
                    }
                    <div class="form-group">
                        <input type="submit" class="btn" value="@T("登录")" style="width:100%">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/static/plugins/jquery214.min.js"></script>
    <script src="~/static/admin/js/login-md5.js"></script>
    <script>
        // 会话过期时后台子页会被 302 到登录页 —— 如果这个登录页出现在**框架页的 iframe 里**，
        // 用户看到的是「点了一下没反应」（整个窗口还停在后台，只有中间那块换了内容）。
        // 这里检测到自己被嵌套，就把**整个窗口**跳到登录页，并保留 returnUrl。
        (function () {
            try {
                if (window.top !== window.self) { window.top.location.href = location.href; }
            } catch (e) { /* 跨域时忽略 */ }
        })();
    </script>
</body>
</html>
