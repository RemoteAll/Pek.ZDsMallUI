@{
    Layout = "Shared/_Layout";
}
@* 语言包：**结构与类名完全对齐 B2B2CShop `Areas/Admin/Views/Languages/Index.cshtml`**
   （搜索区 `ds-search-form` 三个字段：翻译键 / 语言 / 翻译值；`table.ds-default-table`；
   翻译值单元格就地编辑；`ul.pagination`）。字段与 C# 一致：LanKey / LanValue / CultureId。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@Model.lang.menu_languages</h3>
                <h5></h5>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/languages/index" class="current"><span>@Model.lang.common_manage</span></a></li>
                <li><a href="@Model.areaRoute/languages/addlanguages"><span>@Model.lang.common_add</span></a></li>
            </ul>
        </div>
    </div>

    @if (Model.saved != "") {
    <div class="explanation"><div class="title"><h4>@Model.lang.common_saved</h4></div></div>
    }
    @if (Model.error != "") {
    <div class="explanation"><div class="title"><h4 style="color:#c00;">@Model.error</h4></div></div>
    }

    <form method="get" name="formSearch" id="formSearch">
        <div class="ds-search-form">
            <dl>
                <dt>@Model.lang.page_languages_key：</dt>
                <dd><input type="text" value="@Model.lanKey" name="lanKey" class="txt"></dd>
            </dl>
            <dl>
                <dt>@Model.lang.page_languages_language：</dt>
                <dd>
                    <select name="cultureId" id="cultureId">
                        <option value="0">@Model.lang.common_please_select</option>
                        @foreach (var item in Model.cultures) {
                        <option value="@item.id" @if (item.current) {<text>selected</text>}>@item.name</option>
                        }
                    </select>
                </dd>
            </dl>
            <dl>
                <dt>@Model.lang.page_languages_value：</dt>
                <dd><input type="text" value="@Model.lanValue" name="lanValue" class="txt"></dd>
            </dl>
            <div class="btn_group">
                <input type="submit" class="btn" value="@Model.lang.common_search">
            </div>
        </div>
    </form>

    <form method="post" action="@Model.areaRoute/languages/save" name="formSave">
        <input type="hidden" name="CultureId" value="@Model.cultureId">
        <table class="ds-default-table">
            <thead>
                <tr>
                    <th class="w24"></th>
                    <th>@Model.lang.page_languages_key</th>
                    <th>@Model.lang.page_languages_language</th>
                    <th>@Model.lang.page_languages_value</th>
                    <th>@Model.lang.common_actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.rows) {
                <tr>
                    <td><input type="checkbox" class="checkitem" name="nav_id[]" value="@row.ident"></td>
                    <td style="width:auto;"><code>@row.key</code></td>
                    <td style="width:100px;">@Model.cultureName</td>
                    <td>
                        <input name="v_@row.ident" value="@row.value" class="edit-value" type="text">
                    </td>
                    <td style="width:120px;">
                        <a href="@Model.areaRoute/languages/editlanguages?key=@row.key" class="dsui-btn-edit">@Model.lang.common_edit</a>
                        <a href="@Model.areaRoute/languages/delete?culture=@Model.cultureId&key=@row.key" onclick="return confirm('@Model.lang.common_confirm_delete')" class="dsui-btn-del">@Model.lang.common_delete</a>
                    </td>
                </tr>
                }
            </tbody>
            <tfoot>
                <tr class="tfoot">
                    <td><input type="checkbox" class="checkall" id="checkallBottom"></td>
                    <td colspan="4"><label for="checkallBottom">@Model.lang.common_select_all</label></td>
                </tr>
            </tfoot>
        </table>
        <ul class="pagination"></ul>

        <a id="add-language"></a>
        <div class="ncap-form-default">
            <dl>
                <dt>@Model.lang.common_add</dt>
                <dd>
                    <input name="NewKey" class="input-txt" type="text" placeholder="my.custom.key" style="width:260px;">
                    <input name="NewValue" class="input-txt" type="text" placeholder="@Model.lang.page_languages_value">
                    <span class="err"></span>
                </dd>
            </dl>
            <dl>
                <dt></dt>
                <dd><a href="javascript:void(0)" class="btn" onclick="document.forms.formSave.submit()">@Model.lang.common_save</a></dd>
            </dl>
        </div>
    </form>
</div>
