@{
    Layout = "Shared/_Layout";
}
@* 语言包-添加：结构与类名**逐块照抄** B2B2CShop `Areas/Admin/Views/Languages/AddLanguages.cshtml`
   - 页签：管理（跳 index）/ 添加（current）
   - 表单：`form#doc_form`，翻译键用 `div.layui-form-item > label.layui-form-label + div.layui-input-inline > input#LanKey.w830`
   - 每种语言一个 `div.layui-form-item.layui-form-text > textarea.layui-textarea`
   - 底部 `input.btn[type=submit]`
   **不要自行改动版式**（用户要求与 C# 完全一致）。 *@
<div class="page">
    <div class="fixed-bar">
        <div class="item-title">
            <div class="subject">
                <h3>@T("语言包")</h3>
            </div>
            <ul class="tab-base ds-row">
                <li><a href="@Model.areaRoute/languages/index"><span>@T("管理")</span></a></li>
                <li><a href="javascript:void(0)" class="current"><span>@T("新增")</span></a></li>
            </ul>
        </div>
    </div>
    <form id="doc_form" method="post" action="@Model.areaRoute/languages/savelanguages">
        <input type="hidden" name="document_id" value="1" />
        <div class="layui-form-item">
            <label class="layui-form-label"><span class="red">*</span>@T("资源键")</label>
            <div class="layui-input-inline">
                <input type="text" id="LanKey" name="LanKey" autocomplete="off" class="w830" value="">
            </div>
        </div>
        @foreach (var item in Model.languages) {
        <div class="layui-form-item layui-form-text">
            <label class="layui-form-label">@item.name</label>
            <div class="layui-input-block">
                <input type="hidden" name="c_@item.id" value="@item.id" />
                <textarea placeholder="@T("请输入内容")" class="layui-textarea" name="v_@item.id"></textarea>
            </div>
            <div class="col-sm-3"></div>
        </div>
        }
        <div>
            <input class="btn" type="submit" value="@T("提交")" />
        </div>
    </form>
</div>
