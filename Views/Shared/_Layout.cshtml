<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>@Model.title</title>
    @* 版式复用参考工程 C# `Areas/Admin/Views/Shared/_AdminLayout.cshtml`：
       直接用 `admin.css`（后台皮肤）+ `layui.css`；本库**不自造样式**，页面只用 admin.css 里的类名。 *@
    <link rel="stylesheet" href="~/static/admin/css/admin.css">
    <link rel="stylesheet" href="~/static/plugins/js/layui/css/layui.css">
    @await RenderSectionAsync("Head", false)
</head>
<body>
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    @RenderBody()

    <script src="~/static/plugins/jquery214.min.js"></script>
    <script src="~/static/plugins/layer/layer.js"></script>
    <script src="~/static/admin/js/admin.js"></script>
    <script type="text/javascript">
        // 参考工程用 layer 做提示；原生 confirm 已被全局「面板前端交互规范」禁用。
        var ADMINSITEURL = "@Model.areaRoute";
        function dsmalluiConfirm(form, message) {
            if (window.layer) {
                layer.confirm(message, { btn: ['确定', '取消'] }, function (index) {
                    form.submit();
                    layer.close(index);
                });
                return false;
            }
            return true;
        }

        // ————— 后台地址栏「hash 定位」：让子页面地址始终能在框架页里被还原 —————
        //
        // 1) 我在 iframe 里（框架页的子页）→ 把**当前子页地址**同步到父窗口的 hash，
        //    这样在子页里点「新增/编辑」、翻页、搜索之后，刷新仍是这一页、复制链接也能直达；
        // 2) 我**不在** iframe 里（直接打开了某个子页，如 /admin/config/index）→ 自动进框架页，
        //    用 hash 定位到同一个页面（否则左侧菜单、面包屑全丢了）。
        //
        // 只处理「同一个后台区域」下的地址（首段即区域名），避免把登录页/前台页也塞进框架。
        (function () {
            try {
                var current = location.pathname + location.search;
                var area = '/' + location.pathname.split('/')[1];
                var isAreaPage = location.pathname.indexOf(area + '/') === 0 && location.pathname !== area + '/home/index';
                if (!isAreaPage) { return; }

                if (window.parent && window.parent !== window) {
                    var target = '#' + current;
                    if (window.parent.location.hash !== target) {
                        // replaceState 不触发 hashchange，手动派发一次让框架页同步菜单高亮
                        window.parent.history.replaceState(null, '', target);
                        window.parent.dispatchEvent(new window.Event('hashchange'));
                    }
                } else {
                    // 直接访问子页：进框架页并定位（框架页会把 hash 应用到 iframe 与菜单）
                    location.replace(area + '/home/index' + '#' + current);
                }
            } catch (e) {
                // 跨域/受限环境（例如被别站 iframe 嵌）时静默跳过，不影响页面本身
            }
        })();
    </script>
    <!-- 服务端耗时（右下角小角标）：渲染入口 → 输出完，不含网络 -->
    <div class="server-timing" title="服务端渲染耗时：renderView 入口 → 视图输出完成，不含网络与前置取数">渲染 <!--render-ms--> ms</div>
    <style>
        .server-timing {
            position: fixed; right: 10px; bottom: 8px; z-index: 99;
            padding: 2px 8px; border-radius: 10px; font-size: 12px;
            background: rgba(0, 0, 0, .06); color: #6b7280; pointer-events: none;
            font-family: ui-monospace, Consolas, monospace;
        }
    </style>    @await RenderSectionAsync("Scripts", false)
</body>
</html>
