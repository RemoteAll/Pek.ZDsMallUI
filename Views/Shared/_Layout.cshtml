@* pek-zdsmallui:generated v3 *@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <title>@Model.title</title>
    @* 版式复用参考工程 C# `Areas/Admin/Views/Shared/_AdminLayout.cshtml`：
       直接用 `admin.css`（后台皮肤）+ `layui.css`；本库**不自造样式**，页面只用 admin.css 里的类名。 *@
    <link rel="stylesheet" href="/static/admin/css/admin.css">
    <link rel="stylesheet" href="/static/plugins/js/layui/css/layui.css">
    @await RenderSectionAsync("Head", false)
</head>
<body>
    <div id="append_parent"></div>
    <div id="ajaxwaitid"></div>

    @RenderBody()

    <script src="/static/plugins/jquery214.min.js"></script>
    <script src="/static/plugins/layer/layer.js"></script>
    <script src="/static/admin/js/admin.js"></script>
    <script type="text/javascript">
        // 参考工程用 layer 做提示；原生 confirm 已被全局「面板前端交互规范」禁用。
        var ADMINSITEURL = "@Model.areaRoute";
        function dsmalluiConfirm(form, message) {
            if (window.layer) {
                layer.confirm(message, { btn: ['确定', '取消'] }, function (index) {
                    form.submit();
                    layer.close(index);
                });
                return false;
            }
            return true;
        }
    </script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
