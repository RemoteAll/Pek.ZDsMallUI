.{
    .name = .pek_zdsmallui,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9414acd2f66beb34,
    // zzig 是 Zig 侧公共基础库（对齐 Rust 侧 dhrust / C# 侧 DH.NCore）：
    // 本库只依赖它的 http（server/router/controller/view/static_files/web）、
    // value（视图模型）、logs、file/fsio、DateTime、Http（出网）、crypto。
    .dependencies = .{
        .zzig = .{ .path = "../zzig" },
        // JWT / 会话吊销（与 C# `NewLife.Web.JwtBuilder`、Rust `Pek.RPermissions` 字节级互通）
        .pek_zpermissions = .{ .path = "../Pek.ZPermissions" },
        // WAF（爬虫分级 / 注入检测 / CSRF / IP 名单 / CC / 限流 / 规则引擎 / 早拒）
        .pek_zwaf = .{ .path = "../Pek.ZWaf" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "pek_zdsmallui.zig",
        "src",
        "Areas",
        "Controllers",
        "Views",
        "assets",
        "examples",
        "docs",
        "tools",
        "README.md",
    },
}
