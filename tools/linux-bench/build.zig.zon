.{
    .name = .zbench,
    .version = "0.0.0",
    .minimum_zig_version = "0.17.1",
    .fingerprint = 0xbb819b3cc0d453ea,
    .dependencies = .{
        // zzig 已是零外部依赖（HTTP 解析器已收编进它自己的 src/http/），此处只需路径
        .zzig = .{ .path = "../zzig" },
        .zio = .{ .path = "../zio" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
    },
}
