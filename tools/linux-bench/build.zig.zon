.{
    .name = .zbench,
    .version = "0.0.0",
    .minimum_zig_version = "0.17.1",
    .fingerprint = 0xbb819b3cc0d453ea,
    .dependencies = .{
        // 与 zzig 的 build 同源：zzig 自己再解析 ../lighting
        .zzig = .{ .path = "../zzig" },
        .zio = .{ .path = "../zio" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
    },
}
